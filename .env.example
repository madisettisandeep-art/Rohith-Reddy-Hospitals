# Production Environment Variables - Rohith Reddy Hospitals
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://rohithreddyhospitals.com

# Database (PostgreSQL with PgBouncer connection pooling)
DATABASE_URL="postgresql://postgres:password@localhost:5432/rohith_reddy_hospitals?schema=public&sslmode=prefer"

# Optional Upstream Google Places API Integration (Cached 6 hours with automatic resilient fallback)
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""

# Hospital Reception WhatsApp Notification
WHATSAPP_PHONE_NUMBER="919642002222"

# Security & Admin Session Secret
ADMIN_JWT_SECRET="super-secure-jwt-secret-replace-in-production-2026"
